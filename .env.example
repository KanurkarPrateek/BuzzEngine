# ---------------------------------------------------------------------------
# LLM — any provider. Pick one block, delete the rest.
# ---------------------------------------------------------------------------

# Anthropic
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
LLM_API_KEY=sk-ant-...

# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5
# LLM_API_KEY=sk-...

# Any OpenAI-compatible gateway — Groq, OpenRouter, Together, Fireworks, DeepSeek
# LLM_PROVIDER=openai
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...

# Self-hosted: Ollama, vLLM, LM Studio, llama.cpp
# LLM_PROVIDER=openai
# LLM_MODEL=qwen2.5:32b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# Google Gemini
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-pro
# LLM_API_KEY=AIza...

# Some models reject sampling parameters outright — leave this unset unless you
# know yours accepts it.
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2000
# Force native JSON mode on/off. Default: on for openai/gemini, off for anthropic.
# LLM_NATIVE_JSON=1

# ---------------------------------------------------------------------------
# X (Twitter) — required to post
# ---------------------------------------------------------------------------
X_CLIENT_ID=
# Only for confidential apps. Leave unset for a public PKCE app.
# X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8723/callback
# Written by `npm run authorize`. Set this to seed a fresh deployment; after the
# first refresh the live token lives in STATE_DIR and this value goes stale.
# X_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
DRY_RUN=0
STATE_DIR=./state
LOG_LEVEL=info
# LOG_FORMAT=json

MAX_POSTS_PER_DAY=3
MIN_MINUTES_BETWEEN_POSTS=180
# false puts the source link in a self-reply instead of the main post, which is
# far cheaper under X's per-post-with-link pricing.
INCLUDE_LINK_IN_POST=true

TOPICS=ai,llm,agents,developer tools,observability,infrastructure,open source,databases,security
BLOCKED_TERMS=politics,election,crypto pump,nsfw,lawsuit drama
# VOICE=<free text describing how posts should sound — the main tuning knob>

# ---------------------------------------------------------------------------
# Sources
# ---------------------------------------------------------------------------
SOURCES=hn,github,reddit,x

HN_MIN_POINTS=40
HN_LOOKBACK_HOURS=30

GITHUB_MIN_STARS_TODAY=60

REDDIT_SUBREDDITS=programming,LocalLLaMA,MachineLearning
REDDIT_MIN_UPVOTES=150
# Strongly recommended when hosting anywhere but a laptop: Reddit blocks
# unauthenticated JSON from datacenter IPs. Create a "script" app at
# https://www.reddit.com/prefs/apps (free).
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# X buzz signal via twitterapi.io (~$0.15/1k tweets). Omit to disable the source.
# XSEARCH_API_KEY=
# XSEARCH_BASE_URL=https://api.twitterapi.io
XSEARCH_MIN_LIKES=400
XSEARCH_LOOKBACK_HOURS=18
XSEARCH_MAX_QUERIES=3

# ---------------------------------------------------------------------------
# Optional scraping escalation (TRAWL — https://trawl.germondai.com)
# Only consulted when a direct scrape comes back 403/429/451. Unset = never used.
# ---------------------------------------------------------------------------
# TRAWL_URL=http://localhost:8191

# ---------------------------------------------------------------------------
# Media: off | og | screenshot | auto
#
# X gives attached media precedence over the link card, so `og` deliberately
# declines while INCLUDE_LINK_IN_POST=true (X already renders that image, with
# the headline and domain attached). Pair images with INCLUDE_LINK_IN_POST=false.
#
# Needs the media.write scope, requested during `npm run authorize`.
# ---------------------------------------------------------------------------
MEDIA_MODE=off
MEDIA_ALT_TEXT=true
# MEDIA_MAX_BYTES=5242880
# Any service returning raw image bytes for a GET; {url} is substituted.
# SCREENSHOT_URL_TEMPLATE=http://localhost:3000/screenshot?url={url}

# ---------------------------------------------------------------------------
# Editorial
# ---------------------------------------------------------------------------
# Fetch the primary source (README / article text) before writing. Without this
# the writer only has a headline, is asked to add insight, and can only
# speculate — which the gate then correctly rejects.
RESEARCH=true

# Minimum score (1-10) required in EVERY editorial category to publish.
# 8 is the strict "silence beats low quality" reading and posts rarely.
QUALITY_THRESHOLD=7

# 0 keeps the account clean; 1-2 if you want discovery tags.
MAX_HASHTAGS=0

# 280 is the standard limit and caps posts at ~40 words. Raise to 4000 ONLY if
# the account has X Premium — that is what the spec's "30-100 words" requires.
# X_MAX_POST_LENGTH=280
